{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parola Passwort-Manager",
  "version": "0.7.2",
  "identifier": "eu.shadowlessstudios.parola",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix .. run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix .. run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Parola Passwort-Manager",
        "width": 1100,
        "height": 780,
        "minWidth": 780,
        "minHeight": 580
      }
    ],
    "security": {
      "capabilities": ["parola-main"]
    }
  },
  "bundle": {
    "active": false
  }
}
