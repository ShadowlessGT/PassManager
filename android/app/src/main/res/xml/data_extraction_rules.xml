<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Parola vault and authentication state must not be copied by Android backup/transfer. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
