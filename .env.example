# Firebase settings are public app configuration, NOT administrative secrets.
# Keep this file as an example; do not commit .env.local, service accounts, or tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ONLY enable after the Google Play product, backend verification and license
# test purchase have been successfully configured. Default: no purchase allowed.
VITE_PLAY_BILLING_ENABLED=false
