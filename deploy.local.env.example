# Parola website – local Hostinger deployment settings
# Copy to deploy.local.env (gitignored); never commit passwords.
# The supplied SHA-Disk template uses the same HOSTINGER_FTP_* variable names.
HOSTINGER_FTP_HOST=ftp.shadowless-studios.eu
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
# IMPORTANT: Set exact subdomain document root in Hostinger, e.g. domains/parola.shadowless-studios.eu/public_html
# Do not guess: check the actual target in the Hostinger hosting panel.
HOSTINGER_FTP_TARGET=
HOSTINGER_FTP_PORT=21
HOSTINGER_FTP_PROTOCOL=ftps
# Optional: plain FTP is refused unless explicitly approved (not recommended)
# HOSTINGER_ALLOW_INSECURE_FTP=true
