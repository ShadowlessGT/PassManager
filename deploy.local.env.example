# Passwort Manager: Parola – lokale Website-Verbindung zu Hostinger
# Kopieren nach deploy.local.env (gitignored). Niemals Passwoerter committen.
# SFTP ueber SSH (empfohlen) – Daten aus Hostinger hPanel > SSH-Zugang.
HOSTINGER_FTP_HOST=191.96.63.25
# Achtung: Hier gehoert der FTP/SSH-Hauptbenutzer aus dem SSH-Zugang hinein.
# Ein separates FTP-Unterkonto (z.B. ...shadowlessgt) kann fuer SFTP ungeeignet sein.
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
# Nur der bestaetigte Ordner der Parola-SUBDOMAIN. Kein Hauptdomain-Root!
# Bei SFTP i.d.R. relativ zum Anmeldeverzeichnis, z.B. parola.
HOSTINGER_FTP_TARGET=
HOSTINGER_FTP_PORT=65002
HOSTINGER_FTP_PROTOCOL=sftp
# SHA256-Hostkey-Fingerprint von Hostinger hPanel > SSH-Zugang.
# Beim ersten "DEPLOY_SITE.cmd probe" wird der empfangene Fingerprint angezeigt.
# NUR nach Vergleich mit Hostinger hier den passenden Wert eintragen.
HOSTINGER_SFTP_HOSTKEY_SHA256=
# Optionale Alternative: explizites FTPS auf Port 21 mit gueltigem TLS-Hostnamen.
# HOSTINGER_FTP_PORT=21
# HOSTINGER_FTP_PROTOCOL=ftps
# Unverschluesseltes FTP ist gesperrt, sofern nicht explizit freigegeben:
# HOSTINGER_ALLOW_INSECURE_FTP=true
