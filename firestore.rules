rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client writes only encrypted vault envelopes; Firebase never receives secret plaintext.
    match /vaults/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['envelope','updatedAt'])
        && request.resource.data.envelope is map
        && request.resource.data.envelope.keys().hasOnly(['v','iterations','salt','nonce','ciphertext','updatedAt'])
        && request.resource.data.envelope.v == 1
        && request.resource.data.envelope.iterations == 600000
        && request.resource.data.envelope.salt is string
        && request.resource.data.envelope.nonce is string
        && request.resource.data.envelope.ciphertext is string
        && request.resource.data.envelope.ciphertext.size() < 900000
        && request.resource.data.updatedAt is timestamp;
    }
    // Entitlements can be created/modified ONLY by trusted Admin SDK Functions.
    match /accessEntitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Raw codes are never stored; hashed redemption records and rate limits are server-private.
    match /redeemCodes/{codeHash} { allow read, write: if false; }
    match /redemptionAttempts/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
